  "downgradeMethods": {
    "ReplaceWithPlaceholder": "Replace unsupported content with placeholder image/text",
    "Remove": "Remove unsupported content entirely",
    "ConvertTo2D": "Convert 3D content to 2D representation",
    "ExtractExternal": "Extract content to external files",
    "FlattenToContent": "Merge interactive content into static content",
    "FlattenToText": "Convert to plain text representation",
    "FlattenToOpaque": "Remove transparency and blend to opaque RGB"
  }
