          "alternative": "Media content removed"
        },
        "audio": {
          "method": "Remove",
          "alternative": "Media content removed"
        },
        "javascript": {
          "method": "Remove",
          "alternative": "Script not supported"
        },
        "3d": {
          "method": "Remove",
          "alternative": "3D content not supported"
        },
        "attachment": {
          "method": "Remove",
          "alternative": "Attachments not supported"
        },
        "layer": {
          "method": "FlattenToContent",
          "alternative": "Layers merged into single view"
        },
        "transparency": {
          "method": "FlattenToOpaque",
          "alternative": "Transparency baked into RGB"
        }
      }
    },
    {
      "id": "wps-ofd-2023",
      "name": "WPS OFD Viewer 2023",
      "vendor": "Kingsoft",
      "version": "2023",
      "description": "金山 WPS OFD 查看器 2023 版本兼容性配置",
