        "audio": {
          "method": "ReplaceWithPlaceholder",
          "alternative": "Audio waveform thumbnail"
        },
        "javascript": {
          "method": "Remove",
          "alternative": "Script disabled for security"
        },
        "3d": {
          "method": "ConvertTo2D",
          "alternative": "Orthographic projection view"
        }
      }
    },
    {
      "id": "baseline-1.0",
      "name": "OFD Baseline 1.0",
      "vendor": "GB/T 33190-2016",
      "version": "1.0",
      "description": "GB/T 33190-2016 标准基线功能集",
      "supportedFeatures": [
        "basic",
        "text",
        "image",
        "vector",
        "colorspace-rgb",
        "colorspace-gray",
        "font-embed"
      ],
      "unsupportedFeatures": [
        "video",
        "audio",
        "javascript",
        "3d",
        "attachment",
        "xfa-form",
        "layer",
        "transparency",
        "annotation",
        "form",
        "signature",
        "bookmark",
        "encryption",
        "permission"
      ],
      "limitations": {
        "maxPageSize": {
          "width": 5000,
