{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OFD Reader Compatibility Profiles",
  "description": "Compatibility profiles for different OFD reader implementations (FR-37)",
  "version": "1.0.0",
  "profiles": [
    {
      "id": "suwell-9.x",
      "name": "Suwell Reader 9.x",
      "vendor": "Suwell",
      "version": "9.x",
      "description": "数科 OFD 阅读器 9.x 系列兼容性配置",
      "supportedFeatures": [
        "basic",
        "text",
        "image",
        "vector",
        "annotation",
        "form",
        "signature",
        "bookmark",
        "layer",
        "transparency",
        "colorspace-rgb",
        "colorspace-cmyk",
        "colorspace-gray",
        "font-embed",
        "font-standard",
        "encryption-sm4",
        "encryption-aes",
        "permission-print",
        "permission-modify",
        "permission-annotate"
      ],
      "unsupportedFeatures": [
        "video",
        "audio",
        "javascript",
        "3d",
        "attachment",
        "xfa-form"
      ],
      "limitations": {
        "maxPageSize": {
          "width": 10000,
          "height": 10000,
          "unit": "mm"
        },
        "maxFileSize": 209715200,
        "maxPages": 10000,
        "maxAnnotations": 1000,
        "maxLayers": 32
      },
      "defaultDowngrades": {
        "video": {
          "method": "ReplaceWithPlaceholder",
          "alternative": "Static image with play icon overlay"
        },
        "audio": {
          "method": "ReplaceWithPlaceholder",
          "alternative": "Static image with speaker icon"
        },
        "javascript": {
          "method": "Remove",
          "alternative": "Script removed, see conversion report"
        },
        "3d": {
          "method": "ConvertTo2D",
          "alternative": "2D screenshot or wireframe view"
        },
        "attachment": {
          "method": "ExtractExternal",
          "alternative": "Extracted to external directory"
        }
      }
    },
    {
      "id": "foxit-11.x",
      "name": "Foxit OFD Reader 11.x",
      "vendor": "Foxit",
      "version": "11.x",
      "description": "福昕 OFD 阅读器 11.x 系列兼容性配置",
      "supportedFeatures": [
        "basic",
        "text",
        "image",
        "vector",
        "annotation",
        "form",
        "signature",
        "bookmark",
        "outline",
        "layer",
        "transparency",
        "colorspace-rgb",
        "colorspace-cmyk",
        "colorspace-gray",
        "colorspace-icc",
        "font-embed",
        "font-standard",
        "font-truetype",
        "encryption-sm4",
        "encryption-aes",
        "permission-print",
        "permission-printhq",
        "permission-modify",
        "permission-annotate",
        "permission-export"
      ],
      "unsupportedFeatures": [
        "video",
        "audio",
        "javascript",
        "3d",
        "xfa-form"
      ],
      "limitations": {
        "maxPageSize": {
          "width": 15000,
          "height": 15000,
          "unit": "mm"
        },
        "maxFileSize": 524288000,
        "maxPages": 50000,
        "maxAnnotations": 5000,
        "maxLayers": 64,
        "maxAttachments": 100
      },
      "defaultDowngrades": {
        "video": {
          "method": "ReplaceWithPlaceholder",
          "alternative": "Poster frame with media info"
