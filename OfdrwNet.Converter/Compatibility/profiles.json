        "maxAnnotations": 2000,
        "maxLayers": 48
      },
      "defaultDowngrades": {
        "video": {
          "method": "ReplaceWithPlaceholder",
          "alternative": "Video thumbnail with filename"
        },
        "audio": {
          "method": "ReplaceWithPlaceholder",
          "alternative": "Audio icon with filename"
        },
        "javascript": {
          "method": "Remove",
          "alternative": "Script execution not supported"
        },
        "3d": {
          "method": "ConvertTo2D",
          "alternative": "Isometric view rendering"
        }
      }
