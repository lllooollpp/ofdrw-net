  "featureRegistry": {
    "basic": "Basic document structure and page layout",
    "text": "Text content and fonts",
    "image": "Raster images (JPEG, PNG, TIFF)",
    "vector": "Vector graphics (paths, shapes)",
    "annotation": "Annotations and markup",
    "form": "Interactive form fields",
    "signature": "Digital signatures",
    "bookmark": "Document bookmarks/outline",
    "outline": "Document outline/navigation",
    "layer": "Optional content groups (layers)",
    "transparency": "Alpha channel and blending modes",
    "video": "Video streams",
    "audio": "Audio streams",
    "javascript": "JavaScript actions",
    "3d": "3D models and annotations",
    "attachment": "File attachments",
    "xfa-form": "XFA (XML Forms Architecture)",
    "colorspace-rgb": "RGB color space",
    "colorspace-cmyk": "CMYK color space",
    "colorspace-gray": "Grayscale color space",
    "colorspace-icc": "ICC profile color management",
    "font-embed": "Embedded fonts",
    "font-standard": "Standard fonts (14 base fonts)",
    "font-truetype": "TrueType font support",
    "encryption-sm4": "SM4 encryption",
    "encryption-aes": "AES encryption",
    "permission-print": "Print permission",
    "permission-printhq": "High-quality print permission",
    "permission-modify": "Modify content permission",
    "permission-annotate": "Add/modify annotations permission",
    "permission-export": "Copy/export content permission"
