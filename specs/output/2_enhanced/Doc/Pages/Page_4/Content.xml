        <ofd:TextObject ID="184" Font="1" Size="4.23" Boundary="31.926 60.287 93.98 5.08"><ofd:TextCode X="0" Y="3.598333">今为患者术后第3天，一般情况可，未诉特殊不适，无发热，无腹胀，无阴道出血，</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="185" Font="1" Size="4.23" Boundary="31.785 65.79 91.44 5.08"><ofd:TextCode X="0" Y="3.598333">查体生命体征平稳，全腹柔软，腹部切口外敷料干燥，无渗血渗液，腹腔引流管已</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="186" Font="1" Size="4.23" Boundary="31.785 71.294 93.98 5.08"><ofd:TextCode X="0" Y="3.598333">拔除，尿管已拔除，小便自解，尿量可，继续预防感染治疗，密切关注患者基本生命</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="187" Font="1" Size="4.23" Boundary="31.785 76.797 25.4 5.08"><ofd:TextCode X="0" Y="3.598333">体征及伤口愈合情况。</ofd:TextCode></ofd:TextObject>
