        <ofd:TextObject ID="191" Font="1" Size="4.23" Boundary="31.785 104.314 91.44 5.08"><ofd:TextCode X="0" Y="3.598333">对患者的病情分析:患者术后第4天，阴道少量出血，未诉发热、下腹痛等不适，</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="192" Font="1" Size="4.23" Boundary="31.785 109.817 106.68 5.08"><ofd:TextCode X="0" Y="3.598333">大小便正常。查体：生命体征平稳，腹部切口愈合好。复查血常规分析[2020-12-29</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="193" Font="1" Size="4.23" Boundary="31.785 115.32 152.4 5.08"><ofd:TextCode X="0" Y="3.598333">08:42:00]:血红蛋白:95.0g/L↓;[2020-12-2910:15:42]:D-二聚体:1271ng/ml</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="194" Font="1" Size="4.23" Boundary="31.785 120.824 93.98 5.08"><ofd:TextCode X="0" Y="3.598333">↑;肝肾功能未见明显异常;张蔚主任医师查房后示：患者一般情况可，告知相关出</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="195" Font="1" Size="4.23" Boundary="31.785 126.327 33.02 5.08"><ofd:TextCode X="0" Y="3.598333">院注意事项，拟于今日出院。</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="196" Font="1" Size="4.23" Boundary="31.785 131.83 78.74 5.08"><ofd:TextCode X="0" Y="3.598333">诊疗意见:患者一般情况可，告知相关出院注意事项，拟于今日出院。</ofd:TextCode></ofd:TextObject>
