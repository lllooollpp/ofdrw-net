<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>OFDRW.NET WinForms Demo - 文档转换工具</Title>
    <Description>基于OFDRW.NET的文档转换演示程序，支持Word、HTML、PDF转OFD</Description>
    <Authors>OFDRW.NET Team</Authors>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Word处理相关包 -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    
    <!-- HTML处理相关包 -->
    <PackageReference Include="HtmlAgilityPack" Version="1.12.2" />
    <PackageReference Include="AngleSharp" Version="1.3.0" />
    
    <!-- PDF处理改用 iText7 -->
    <PackageReference Include="itext7" Version="8.0.4" />
    <!-- CJK 字体/ CMap 支持 -->
    <PackageReference Include="itext7.font-asian" Version="8.0.4" />
    
    <!-- 通用工具包 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="2.12.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="4.1.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfdrwNet.Converter\OfdrwNet.Converter.csproj" />
    <ProjectReference Include="..\OfdrwNet\OfdrwNet.csproj" />
  </ItemGroup>

</Project>