        <ofd:TextObject ID="2430" Font="1" Size="3.5" Boundary="31.7 74.4 46.2 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">米为单位,这样的局部坐标空间就称为对象空间。</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2431" Font="1" Size="1" Boundary="31.7 81.65 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2432" Font="1" Size="3.5" Boundary="31.7 85.65 90.3 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">绘制图元时,应首先通过外接矩形参数平移到对象空间内,在对象空间内根据变换矩阵和裁剪设置</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2433" Font="1" Size="1" Boundary="31.7 92.9 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2434" Font="1" Size="3.5" Boundary="31.7 96.9 14.7 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">进行相应绘制。</ofd:TextCode></ofd:TextObject>
