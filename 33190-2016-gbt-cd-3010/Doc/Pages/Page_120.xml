        <ofd:TextObject ID="2399" Font="1" Size="1" Boundary="31.7 126.65 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2400" Font="1" Size="3.5" Boundary="31.7 130.65 86.1 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">设备空间的原点轴方向与坐标单位的实际长度都会由于设备不同而有很大的差异页面的内容不</ofd:TextCode></ofd:TextObject>
