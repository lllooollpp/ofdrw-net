        <ofd:TextObject ID="2385" Font="1" Size="1" Boundary="31.7 47.9 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2386" Font="1" Size="3.5" Boundary="31.7 51.9 90.3 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">页面中的所有图元都在坐标空间内进行描述,一个坐标空间包括坐标原点、坐标轴方向、坐标单位</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2387" Font="1" Size="1" Boundary="31.7 59.15 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2388" Font="1" Size="3.5" Boundary="31.7 63.15 94.5 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">长度三个要素。坐标空间根据用途不同分为设备空间、页面空间、对象空间三类。不同的坐标空间之间</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2389" Font="1" Size="1" Boundary="31.7 70.4 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2390" Font="1" Size="3.5" Boundary="31.7 74.4 37.8 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">通过平移、缩放、旋转、切变进行变换。</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2391" Font="1" Size="1" Boundary="31.7 81.65 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2392" Font="1" Size="3.5" Boundary="31.7 85.65 21 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">8.1.2 设备空间</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2393" Font="1" Size="1" Boundary="31.7 92.9 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2394" Font="1" Size="3.5" Boundary="31.7 96.9 88.2 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">页面中的内容最终需要输出到某一设备上,而每个设备都会拥有自己的坐标空间以便在绘制区域</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2395" Font="1" Size="1" Boundary="31.7 104.15 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2396" Font="1" Size="3.5" Boundary="31.7 108.15 63 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">内能够正确绘制每个图元,设备本身的坐标空间就称之为设备空间。</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2397" Font="1" Size="1" Boundary="31.7 115.4 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
