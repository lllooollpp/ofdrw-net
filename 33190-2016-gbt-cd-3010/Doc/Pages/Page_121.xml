        <ofd:TextObject ID="2402" Font="1" Size="3.5" Boundary="31.7 29.4 25.2 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">应直接在设备空间上描述。</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2403" Font="1" Size="1" Boundary="31.7 36.65 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2404" Font="1" Size="3.5" Boundary="31.7 40.65 21 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">8.1.3 页面空间</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2405" Font="1" Size="1" Boundary="31.7 47.9 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2406" Font="1" Size="3.5" Boundary="31.7 51.9 71.4 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">页面空间是一个与设备无关的坐标空间系统,用来描述图元和其他页面要素。</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2407" Font="1" Size="1" Boundary="31.7 59.15 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2408" Font="1" Size="3.5" Boundary="31.7 63.15 86.1 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">页面空间规定页面的左上角为原点,轴向右增长,轴向下增长,以毫米为单位。整个页面空间</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2409" Font="1" Size="1" Boundary="31.7 70.4 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2410" Font="1" Size="3.5" Boundary="31.7 74.4 6.3 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">X Y</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2411" Font="1" Size="1" Boundary="31.7 81.65 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2412" Font="1" Size="3.5" Boundary="31.7 85.65 14.7 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">( ) 。 、</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2413" Font="1" Size="1" Boundary="31.7 92.9 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2414" Font="1" Size="3.5" Boundary="31.7 96.9 102.9 5.25" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="3.5">的大小由PaeArea节点见7.5文档根节点中的PhsicalBox确定页面空间根据原点平移轴方向</ofd:TextCode></ofd:TextObject>
        <ofd:TextObject ID="2415" Font="1" Size="1" Boundary="31.7 104.15 0.6 2" CTM="1 0 0 1 0 0"><ofd:TextCode X="0" Y="1"> </ofd:TextCode></ofd:TextObject>
